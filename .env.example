# Copy this file to .env and fill in both values. Never commit .env.

# From platform.claude.com → API keys
ANTHROPIC_API_KEY=

# Any phrase you choose. The app asks for it once; every API call must send it.
# If this is empty, the API refuses all requests.
APP_PASSCODE=

# Optional. Defaults to claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5
